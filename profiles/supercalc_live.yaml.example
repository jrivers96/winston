# Supercalc LIVE profile template
# Copy to profiles/supercalc_live.yaml (gitignored) before filling secrets/providers.
# Source of truth: polymarket-gvf Postgres (Cloud SQL), not Winston agent DB.
# Prefer read-only role + Auth Proxy / private path across projects.

profile_id: supercalc_live
description: "Opt-in live read-only smoke for Supercalc (polymarket-gvf) Postgres"
version: "0.3.0"
capability_label: live-template

live_smoke:
  enabled_by_default: false
  require_env_flag: WINSTON_LIVE_SMOKE
  budgets:
    max_business_dates: 3
    max_rows: 500
    max_seconds: 60
  allowed_operations:
    - read_index_definitions
    - read_index_series
    - read_integrity_checks
    - read_hedge_outcomes
    - read_risk_rollups
    - read_signals
  forbidden_operations:
    - mutate_data
    - trigger_jobs
    - publish_results
    - remediate_production

postgres:
  # Real instance: adept-snow-481601-c6:us-central1:polymarket-gvf-db-small
  # Leave host blank in the example; filled local profile may use private IP or Auth Proxy.
  host: ""
  port: 5432
  database: ""
  sslmode: ""
  auth_method: ""
  credential_provider: ""
  connect_timeout_seconds: 30
  statement_timeout_seconds: 60
  private_ip_required: true
  read_only: true
  connection_name: ""   # e.g. project:region:instance for Cloud SQL Auth Proxy
  mappings:
    # Tables/columns from polymarket-gvf/storage/models.py — leave blank in example
    index_definitions:
      relation: ""
      columns:
        id: ""
        index_name: ""
        candidate_id: ""
        status: ""
        promoted_at: ""
        retired_at: ""
        last_score: ""
        thresholds: ""
        notes: ""
        created_at: ""
        updated_at: ""
    index_series:
      relation: ""
      columns:
        id: ""
        timestamp: ""
        index_name: ""
        value: ""
        index_metadata: ""
        created_at: ""
    integrity_checks:
      relation: ""
      columns:
        id: ""
        run_ts: ""
        check_name: ""
        status: ""
        observed: ""
        threshold: ""
        details: ""
        created_at: ""
    hedge_alert_outcomes:
      relation: ""
      columns:
        id: ""
        alerted_at: ""
        market_id: ""
        signal_type: ""
        onset_ts: ""
        horizon_minutes: ""
        expected_edge: ""
        one_leg_cost: ""
        hit: ""
        scored_at: ""
        created_at: ""
    risk_rollups:
      relation: ""
      columns:
        id: ""
        as_of_ts: ""
        theme: ""
        rollup_version: ""
        n_markets: ""
        transition_risk_mean: ""
        transition_risk_max: ""
        created_at: ""
    signals:
      relation: ""
      columns:
        id: ""
        market_id: ""
        timestamp: ""
        signal_blob: ""
        created_at: ""

datadog:
  enabled: false
  site: ""
  auth_method: ""
  credential_provider: ""
  metrics: []
  services: []

indices:
  - id: ""
    environment: ""
    owner: ""
    description: "Fill with a real Supercalc index_name from indexes / discovered_index_definitions"

required_env:
  - WINSTON_LIVE_SMOKE=1
  - WINSTON_OFFLINE_MODE=false
