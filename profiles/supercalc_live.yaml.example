# Supercalc LIVE profile template (incomplete by design)
# Copy to profiles/supercalc_live.yaml (gitignored locally) and fill real values.
# Supercalc system of record is Postgres — not Databricks.
# Do NOT invent production relation/column names. Leave blanks until known.
# Secrets stay in env / Secret Manager — never in this file.
# Prefer Supercalc-owned views over raw tables across project boundaries.

profile_id: supercalc_live
description: "Opt-in live read-only smoke for Supercalc Postgres-shaped products"
version: "0.2.0"
capability_label: live-template  # becomes live-verified only after successful smoke

live_smoke:
  enabled_by_default: false
  require_env_flag: WINSTON_LIVE_SMOKE
  budgets:
    max_business_dates: 3
    max_rows: 500
    max_seconds: 60
  allowed_operations:
    - read_executions
    - read_manifests
    - read_state_refs
    - read_calendars
  forbidden_operations:
    - mutate_data
    - trigger_jobs
    - publish_results
    - remediate_production

postgres:
  # Cross-project read-only access to Supercalc Postgres (not Winston Cloud SQL)
  host: ""                       # private host / Auth Proxy endpoint — do not invent
  port: 5432
  database: ""
  sslmode: ""                    # e.g. require | verify-full
  auth_method: ""                # password | iam | cloudsql_iam
  credential_provider: ""        # reference only, e.g. secret:winston-staging-supercalc-pg-password
  connect_timeout_seconds: 30
  statement_timeout_seconds: 60
  private_ip_required: true      # align with org public-IP restrictions
  read_only: true
  mappings:
    # Prefer views Supercalc owns; relation = view or table name (no invented names)
    index_definitions:
      relation: ""
      columns:
        index_id: ""
        environment: ""
        owner: ""
        calendar_ref: ""
        timezone: ""
    calendars:
      relation: ""
      columns:
        calendar_id: ""
        business_date: ""
        is_calculation_day: ""
        previous_calculation_date: ""
        timezone: ""
    executions:
      relation: ""
      columns:
        execution_id: ""
        index_id: ""
        environment: ""
        business_date: ""
        attempt_id: ""
        start_time: ""
        end_time: ""
        status: ""
        input_manifest_id: ""
        code_manifest_id: ""
        output_ref: ""
        state_ref: ""
    input_manifests:
      relation: ""
      columns:
        manifest_id: ""
        execution_id: ""
        parent_state_refs: ""
        input_dataset_refs: ""
        configuration_ref: ""
    artifacts:
      relation: ""
      columns:
        artifact_id: ""
        execution_id: ""
        artifact_type: ""
        schema_version: ""
        content_hash: ""
        storage_ref: ""
    selected_revisions:
      relation: ""
      columns:
        index_id: ""
        environment: ""
        business_date: ""
        selected_execution_id: ""
        selection_policy: ""
        selection_time: ""

# Optional telemetry — not required for live-smoke readiness
datadog:
  enabled: false
  site: ""                     # e.g. datadoghq.com
  auth_method: ""              # api_key | oauth
  credential_provider: ""
  metrics: []
  services: []

indices:
  - id: ""                     # live index id once known
    environment: ""
    owner: ""
    calendar_ref: ""
    timezone: ""
    description: "Fill with real Supercalc product identity — do not invent"

required_env:
  - WINSTON_LIVE_SMOKE=1
  - WINSTON_OFFLINE_MODE=false
  # Credential env / secrets are organization-specific; document references only:
  # - secret:winston-staging-supercalc-pg-password (or env via credential_provider)
