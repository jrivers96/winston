# Local Terraform artifacts — never commit state or real tfvars
# Keep .terraform.lock.hcl in git for reproducible provider versions.
.terraform/
*.tfstate
*.tfstate.*
tfplan
crash.log
crash.*.log
terraform.tfvars
*.auto.tfvars
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraform.tfstate.lock.info
