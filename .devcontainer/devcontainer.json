{
  "name": "Winston",
  "dockerComposeFile": ["../docker-compose.yaml"],
  "service": "winston",
  "workspaceFolder": "/workspace",
  "shutdownAction": "stopCompose",
  "overrideCommand": false,
  "forwardPorts": [5432],
  "portsAttributes": {
    "5432": {
      "label": "Winston PostgreSQL",
      "onAutoForward": "silent"
    }
  },
  "containerEnv": {
    "WINSTON_DATABASE_URL": "postgresql://winston:winston_dev@postgres:5432/winston",
    "WINSTON_TEST_DATABASE_URL": "postgresql://winston:winston_dev@postgres:5432/winston_test",
    "WINSTON_DATA_DIR": "/workspace/.winston",
    "WINSTON_OFFLINE_MODE": "true",
    "WINSTON_PROFILE": "synthetic"
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "postStartCommand": "bash .devcontainer/post-start.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff",
        "ms-azuretools.vscode-docker",
        "tamasfe.even-better-toml"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.terminal.activateEnvironment": false,
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": ["tests"],
        "editor.formatOnSave": true,
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff",
          "editor.codeActionsOnSave": {
            "source.organizeImports.ruff": "explicit"
          }
        }
      }
    }
  },
  "remoteUser": "vscode"
}
